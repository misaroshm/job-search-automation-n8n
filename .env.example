# Copy to .env and fill in. .env is never committed.

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Your Telegram chat id. Leave empty at first: write /start to the bot and it will tell you the id.
TELEGRAM_CHAT_ID=

# Google Sheet id: the long part of the sheet URL between /d/ and /edit
SHEET_ID=

# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=models/gemini-3.5-flash-lite

# --- Tuning ---
# Keyword score a vacancy needs before the AI looks at it
MIN_SCORE=20
# AI checks per search run (the free Gemini tier has rate limits)
MAX_AI_CHECKS=20
# Vacancy cards sent to Telegram per run
MAX_CARDS=15
# "No movement" warning in the morning digest, days
STALE_DAYS=7
# "Applied" with no answer for this long becomes "no answer", days
GHOST_DAYS=21
